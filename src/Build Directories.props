<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <BuildDir>$(SolutionDir)Build\</BuildDir>
  </PropertyGroup>
  <PropertyGroup>
    <_PropertySheetDisplayName>Lasernet Build Directories</_PropertySheetDisplayName>
    <OutDir>$(BuildDir)$(PlatformName)\$(Configuration)\</OutDir>
    <IntDir>$(OutDir)Intermediate\$(ProjectName)\</IntDir>
    <BuildDirectoriesImported>true</BuildDirectoriesImported>
  </PropertyGroup>
  <ItemGroup>
    <BuildMacro Include="BuildDir">
      <Value>$(BuildDir)</Value>
    </BuildMacro>
  </ItemGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(SolutionDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
